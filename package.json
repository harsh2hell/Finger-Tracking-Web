{
  "name": "finger-tracking-desktop",
  "version": "2.0.0-beta.1",
  "description": "Cross-platform Finger Tracking and Gesture Control Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win"
  },
  "keywords": [
    "mediapipe",
    "electron",
    "gesture-control",
    "computer-vision"
  ],
  "author": "harsh2hell",
  "license": "GPL-3.0",
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.harsh2hell.trackos",
    "productName": "TrackOS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TrackOS"
    }
  }
}
